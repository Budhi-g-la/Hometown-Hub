
{% extends "base.html" %}
{% block title %}Home - Hometown Hub{% endblock %}

{% block content %}
<section class="hero text-center p-5 rounded-4 mb-4">
    <h1>Welcome to Hometown Hub 🏡</h1>
    <p>One Community, One Platform, One Family.</p>
    <p>Connect with neighbours, share updates and discover local events.</p>
</section>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm p-3">
            <h3>Share a Community Update</h3>
            <form action="/create-post" method="POST">
                <input class="form-control mb-3" name="name" placeholder="Your name" required>
                <input class="form-control mb-3" name="title" placeholder="Post title" required>
                <textarea class="form-control mb-3" name="content" rows="4" placeholder="What's happening in your hometown?" required></textarea>
                <button class="btn btn-primary w-100">Publish Post</button>
            </form>
        </div>

        <div class="card shadow-sm p-3 mt-4">
            <h3>Upcoming Events 📅</h3>
            {% for event in events %}
                <div class="border-bottom py-2">
                    <h5>{{ event.title }}</h5>
                    <p class="mb-1">{{ event.event_date }}</p>
                    <p>{{ event.description }}</p>
                </div>
            {% else %}
                <p>No events announced yet.</p>
            {% endfor %}
        </div>
    </div>

    <div class="col-lg-7">
        <h3 class="mb-3">Community Posts 💬</h3>
        {% for post in posts %}
            <div class="card shadow-sm p-3 mb-3">
                <h4>{{ post.title }}</h4>
                <small class="text-muted">Posted by {{ post.name }} · {{ post.created_at }}</small>
                <p class="mt-3">{{ post.content }}</p>

                <hr>
                <h6>Leave a Comment</h6>
                <form action="/comment/{{ post.id }}" method="POST">
                    <input class="form-control mb-2" name="name" placeholder="Your name" required>
                    <textarea class="form-control mb-2" name="content" placeholder="Write a comment..." required></textarea>
                    <button class="btn btn-outline-primary btn-sm">Comment</button>
                </form>
            </div>
        {% else %}
            <div class="alert alert-info">No community posts yet. Be the first to share something!</div>
        {% endfor %}
    </div>
</div>
{% endblock %}
