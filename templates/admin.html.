
{% extends "base.html" %}
{% block title %}Admin Dashboard - Hometown Hub{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Admin Dashboard 🛠️</h2>
    <a href="/admin/logout" class="btn btn-danger">Logout</a>
</div>

<div class="card shadow-sm p-4 mb-4">
    <h3>Add a Community Event 📅</h3>
    <form action="/admin/add-event" method="POST">
        <input class="form-control mb-3" name="title" placeholder="Event title" required>
        <input class="form-control mb-3" type="date" name="event_date">
        <textarea class="form-control mb-3" name="description" placeholder="Event description"></textarea>
        <button class="btn btn-primary">Add Event</button>
    </form>
</div>

<div class="card shadow-sm p-4 mb-4">
    <h3>Manage Events</h3>
    {% for event in events %}
        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
            <div>
                <strong>{{ event.title }}</strong>
                <p class="mb-0">{{ event.event_date }} - {{ event.description }}</p>
            </div>
            <form action="/admin/delete-event/{{ event.id }}" method="POST">
                <button class="btn btn-sm btn-danger">Delete</button>
            </form>
        </div>
    {% else %}
        <p>No events available.</p>
    {% endfor %}
</div>

<div class="card shadow-sm p-4">
    <h3>Manage Community Posts</h3>
    {% for post in posts %}
        <div class="border-bottom py-3">
            <h5>{{ post.title }}</h5>
            <p>{{ post.content }}</p>
            <small>Posted by {{ post.name }}</small>
            <form action="/admin/delete/{{ post.id }}" method="POST" class="mt-2">
                <button class="btn btn-sm btn-danger">Delete Post</button>
            </form>
        </div>
    {% else %}
        <p>No posts available.</p>
    {% endfor %}
</div>
{% endblock %}
